# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key (console.anthropic.com). Without it, set DEMO_MODE=true.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# RIPPLE_MODEL=claude-opus-5-5

# DEMO_MODE=true serves pre-written quests instantly, skips the AI photo check when no API key is set,
# and allows the "demo location" override for indoor demos. Set both to the same value.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
